{
  "name": "magpie-univibe-auth",
  "version": "0.1.3",
  "description": "Use Univibe models and monitor daily credits in Magpie and OpenCode.",
  "keywords": [
    "auth",
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "univibe"
  ],
  "homepage": "https://github.com/chansyawn/magpie-univibe-auth#readme",
  "bugs": {
    "url": "https://github.com/chansyawn/magpie-univibe-auth/issues"
  },
  "license": "MIT",
  "author": "chansyawn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chansyawn/magpie-univibe-auth.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "magpie": {
    "name": "Univibe",
    "icon": "https://www.univibe.cc/favicon.ico",
    "summary": {
      "en": "Use a Univibe subscription in Magpie with credits and daily reset.",
      "zh": "在 Magpie 中使用 Univibe 订阅，并显示积分与每日自动重置。"
    },
    "maxConcurrency": 4
  }
